{
  "name": "governed-operations-yarn",
  "description": "Yarn commands graded after every attempt. Keep install named \"install\" for fingerprint skip across attempts.",
  "requiresNoSecrets": true,
  "forbiddenCommands": [
    "npm install",
    "npm run",
    "pnpm install",
    "pnpm run"
  ],
  "commands": [
    {
      "name": "install",
      "command": "yarn install",
      "timeoutMs": 300000,
      "purpose": "Install workspace dependencies."
    },
    {
      "name": "lint",
      "command": "yarn lint",
      "timeoutMs": 180000,
      "purpose": "Lint the Next.js workspace."
    },
    {
      "name": "test",
      "command": "yarn test",
      "timeoutMs": 420000,
      "purpose": "Unit tests for the Next.js workspace."
    },
    {
      "name": "build",
      "command": "yarn next:build",
      "timeoutMs": 300000,
      "purpose": "Production build (includes TypeScript checks)."
    }
  ]
}
