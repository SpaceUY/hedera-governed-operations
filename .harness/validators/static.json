{
  "name": "governed-operations-static",
  "description": "Files and text a fresh scaffold of this template must ship with. template.json is not asserted: create-scaffold-hbar removes it when scaffolding.",
  "jsonAssertions": [
    {
      "file": "package.json",
      "path": "packageManager",
      "equals": "yarn@3.2.3"
    }
  ],
  "fileAssertions": {
    "required": [
      "README.md",
      "AGENTS.md",
      "package.json",
      "packages/core/package.json",
      "packages/agent/package.json",
      "packages/nextjs/package.json",
      "packages/nextjs/.env.example",
      "packages/agent/.env.example",
      "packages/hardhat/package.json",
      "packages/hardhat/hardhat.config.ts",
      "packages/hardhat/contracts/GovernedExecutor.sol",
      "packages/hardhat/.env.example",
      "packages/nextjs/app/(governance)/layout.tsx",
      ".harness/spec.yaml",
      ".harness/prd.md"
    ],
    "forbidden": [".env", "packages/nextjs/.env", "packages/hardhat/.env", "packages/agent/.env"]
  },
  "textAssertions": [
    {
      "file": "README.md",
      "contains": ["yarn install", "yarn next:dev"]
    },
    {
      "file": "packages/nextjs/components/Header.tsx",
      "contains": ["Governed Operations", "Live map", "MirrorPollStatus"]
    },
    {
      "file": "packages/nextjs/components/MirrorPollStatus.tsx",
      "contains": ["Mirror Node · "]
    },
    {
      "file": "packages/nextjs/app/(governance)/layout.tsx",
      "contains": ["resolveGovernanceConfig", "SetupNotice", "Live map", "LiveMapPane"]
    },
    {
      "file": "packages/nextjs/app/(governance)/page.tsx",
      "contains": ["New proposal", "partitionProposals"]
    },
    {
      "file": "packages/nextjs/components/SetupNotice.tsx",
      "contains": ["Governance is not set up yet"]
    },
    {
      "file": "packages/nextjs/components/governance/rail/copy.ts",
      "contains": ["You are viewing the demo instance on testnet", "yarn setup"]
    },
    {
      "file": "packages/hardhat/hardhat.config.ts",
      "contains": ["hederaTestnet", "hederaMainnet", "sourcify"]
    },
    {
      "file": "packages/nextjs/app/(governance)/governance/new/page.tsx",
      "contains": ["New proposal"]
    },
    {
      "file": "packages/nextjs/components/governance/wizard/copy.ts",
      "contains": ["Connect a wallet to propose", "Register and schedule with your wallet"]
    },
    {
      "file": "packages/nextjs/services/governance/proposalLabels.ts",
      "contains": ["Pending operations", "Recent", "There is no execute button."]
    },
    {
      "file": "packages/nextjs/components/governance/wizard/CouncilPreviewPanel.tsx",
      "contains": ["What the council will see"]
    },
    {
      "file": "packages/nextjs/components/governance/graph/copy.ts",
      "contains": ["who may act", "would happen", "where the money is", "switches off", "Nobody on this screen pressed anything", "Ids and links", "Close inspector"]
    },
    {
      "file": "packages/nextjs/components/governance/wizard/copy.ts",
      "contains": ["Approve it in HashPack"]
    },
    {
      "file": "packages/nextjs/components/governance/MutationError.tsx",
      "contains": ["The approval took too long and the transaction expired", "The request expired before it was approved"]
    },
    {
      "file": "packages/nextjs/components/governance/rail/copy.ts",
      "contains": ["Find a proposal by schedule id", "Show fewer", "Expiring now"]
    },
    {
      "file": "packages/nextjs/components/governance/graph/caption.ts",
      "contains": ["Nothing moves until the", "Drafting.", "Dashed violet is what would happen once the", "Fill in the form to see exactly what it would do."]
    },
    {
      "file": "packages/nextjs/services/liveMap/preview/kinds/upgrade.ts",
      "contains": ["would become v2"]
    },
    {
      "file": "packages/nextjs/services/liveMap/preview/kinds/registry.ts",
      "contains": ["PREVIEW_KINDS"]
    },
    {
      "file": "packages/nextjs/components/governance/wizard/copy.ts",
      "contains": ["Sent with your wallet."]
    },
    {
      "file": "packages/nextjs/components/governance/rail/copy.ts",
      "contains": ["HashPack cannot sign this step", "HashPack cannot sign a schedule delete yet", "such as Kabila", "Use another wallet"]
    }
  ]
}
