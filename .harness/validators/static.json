{
  "name": "template-baseline-static",
  "description": "Files and text a fresh scaffold of this template must ship with. template.json is not asserted: create-scaffold-hbar removes it when scaffolding.",
  "jsonAssertions": [
    {
      "file": "package.json",
      "path": "packageManager",
      "equals": "yarn@3.2.3"
    }
  ],
  "fileAssertions": {
    "required": [
      "README.md",
      "AGENTS.md",
      "package.json",
      "packages/nextjs/package.json",
      "packages/nextjs/.env.example",
      "packages/hardhat/package.json",
      "packages/hardhat/hardhat.config.ts",
      "packages/hardhat/contracts/GovernedExecutor.sol",
      "packages/hardhat/.env.example",
      ".harness/spec.yaml",
      ".harness/prd.md"
    ],
    "forbidden": [".env", "packages/nextjs/.env", "packages/hardhat/.env"]
  },
  "textAssertions": [
    {
      "file": "README.md",
      "contains": ["yarn install", "yarn next:dev"]
    },
    {
      "file": "packages/nextjs/app/page.tsx",
      "contains": ["Governed Operations", "Pending proposals"]
    },
    {
      "file": "packages/nextjs/components/SetupNotice.tsx",
      "contains": ["Governance is not set up yet"]
    },
    {
      "file": "packages/hardhat/hardhat.config.ts",
      "contains": ["hederaTestnet", "hederaMainnet", "sourcify"]
    },
    {
      "file": "packages/nextjs/app/governance/new/page.tsx",
      "contains": ["New proposal", "Connect a wallet to propose"]
    },
    {
      "file": "packages/nextjs/components/governance/wizard/CouncilPreviewPanel.tsx",
      "contains": ["What the council will see"]
    }
  ]
}
