NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=https://mainnet.hashio.io/api
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
NEXT_PUBLIC_PROOF_WALL_TOPIC_ID=

# Topic the release manifests go to, written by `yarn setup`. `yarn release:publish` submits to it
# and the co-signing agent checks an upgrade proposal against it. The operator is its submit key:
# reading is public, writing is not, and the agent refuses a topic anyone could publish to.
NEXT_PUBLIC_RELEASE_TOPIC_ID=
NEXT_PUBLIC_PROOF_WALL_BADGE_TOKEN_ID=

# Operator account used server-side (API routes) and by `yarn setup`; keep it out of git
HEDERA_OPERATOR_ID=
# ECDSA private key of the operator (DER-encoded or HEX -- either form the Hedera Portal shows works; it is parsed explicitly as ECDSA)
HEDERA_OPERATOR_PRIVATE_KEY=
# testnet or mainnet for the app; `yarn setup` only runs on testnet
HEDERA_NETWORK=testnet
# Your own Hedera account: it becomes one of the three keys on the governance account created by
# `yarn setup` — the only one a human holds — and is granted PROPOSER_ROLE when the contracts are
# deployed. Use the account you will connect with; changing it later means a new governance
# account and a fresh deployment. Required by `yarn setup`
HEDERA_COUNCIL_ACCOUNT_ID=
# Same network for client-side Mirror Node reads (hooks/mirror, badge lookups); defaults to testnet
NEXT_PUBLIC_HEDERA_NETWORK=testnet
# Server-side Mirror Node base URL overrides; leave them commented out for the public mirrors
# HEDERA_MIRROR_TESTNET_URL=
# HEDERA_MIRROR_MAINNET_URL=
# HEDERA_MIRROR_PREVIEWNET_URL=

# Test signer: an ECDSA key stored as localStorage["burnerWallet.pk"] signs instead of HashPack
# (used by Hedera Harness CHAIN). Testnet only; always on in dev, set to true to allow it in a production build
NEXT_PUBLIC_ENABLE_BURNER_SIGNER=

# Written by `yarn setup` into .env.local; leave empty here
NEXT_PUBLIC_DEMO_ACCOUNT_ALICE_ID=
NEXT_PUBLIC_DEMO_ACCOUNT_BOB_ID=
NEXT_PUBLIC_GOVERNANCE_ACCOUNT_ID=
NEXT_PUBLIC_DEMO_TOKEN_ID=
NEXT_PUBLIC_SEED_PROPOSAL_ID=
# Topic the co-signing agent publishes its decisions to. Its submit key is the agent's own seat, not
# the operator's, so the log says what the agent decided rather than what somebody claims it did.
# Copy it into packages/agent/.env; the app does not read it
AGENT_DECISION_TOPIC_ID=
