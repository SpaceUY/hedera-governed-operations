NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=https://mainnet.hashio.io/api
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
NEXT_PUBLIC_PROOF_WALL_TOPIC_ID=
NEXT_PUBLIC_PROOF_WALL_BADGE_TOKEN_ID=

# Operator account used server-side (API routes) and by `yarn setup`; keep it out of git
HEDERA_OPERATOR_ID=
# ECDSA private key of the operator (DER or hex)
HEDERA_OPERATOR_PRIVATE_KEY=
# testnet or mainnet for the app; `yarn setup` only runs on testnet
HEDERA_NETWORK=testnet

# Written by `yarn setup` into .env.local; leave empty here
NEXT_PUBLIC_DEMO_ACCOUNT_ALICE_ID=
NEXT_PUBLIC_DEMO_ACCOUNT_BOB_ID=
