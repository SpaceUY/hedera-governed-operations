# Hedera JSON-RPC endpoint (testnet default, change for mainnet)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill manually. Run yarn generate or yarn account:import first.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# EVM address of the account holding the threshold key. It is the only EXECUTOR_ROLE member of
# GovernedExecutor; never point it at a single-signer account. Required to deploy on Hedera.
GOVERNANCE_ACCOUNT_ADDRESS=

# Comma-separated EVM addresses granted PROPOSER_ROLE at deployment. Required to deploy on Hedera.
INITIAL_PROPOSERS=
