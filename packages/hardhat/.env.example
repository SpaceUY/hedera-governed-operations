# JSON-RPC endpoint the local forked node reads from (`yarn hardhat:chain`, `yarn hardhat:fork`).
# Deploys do not use it: hederaTestnet and hederaMainnet carry their own Hashio URLs.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill manually. Run yarn generate or yarn account:import first.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# The two values below are written by `yarn setup`, which creates the governance account before
# these contracts can be deployed against it. Fill them by hand only to deploy without it.

# EVM address of the account holding the threshold key. It is the only EXECUTOR_ROLE member of
# GovernedExecutor; never point it at a single-signer account. Required to deploy on Hedera.
GOVERNANCE_ACCOUNT_ADDRESS=

# Comma-separated EVM addresses granted PROPOSER_ROLE at deployment. The role's admin is the
# contract itself, so this list is the only chance to grant it without an approved proposal.
# Required to deploy on Hedera.
INITIAL_PROPOSERS=
