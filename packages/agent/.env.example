# The account this agent signs as. On testnet it is the one `yarn setup` creates for it, outside the
# council: take `demoAccounts.agent` out of packages/nextjs/setup-state.json. Until the council seats
# it ("Add the co-signing agent" in the app), the agent reads, decides and logs but signs nothing, and
# says so with a `seat-missing` line — a signature without a seat is charged in full and counts for
# nothing. See README.md.
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=

# What it watches. Both are written to packages/nextjs/.env.local by `yarn setup`.
GOVERNANCE_ACCOUNT_ID=
EXECUTOR_CONTRACT_ID=

# JSON-RPC relay, for reading the registry entry behind a contract-backed proposal.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# testnet or mainnet; the agent refuses to start on anything else.
HEDERA_NETWORK=testnet

# Topic every decision is published to, written to packages/nextjs/.env.local by `yarn setup`. Its
# submit key has to be this agent's own key, which is what makes the log a record of what this agent
# decided; the agent refuses to start on a topic anyone can write to or one held by another key.
AGENT_DECISION_TOPIC_ID=

# The limits, as a JSON file. See policy.example.json and README.md. An upgrade rule's
# manifestTopicId is the NEXT_PUBLIC_RELEASE_TOPIC_ID that `yarn setup` writes to
# packages/nextjs/.env.local.
AGENT_POLICY_FILE=./policy.example.json

# Milliseconds between passes over the inbox. Minimum 5000.
AGENT_POLL_INTERVAL_MS=15000

# Decide and log, sign nothing — and publish nothing either, since a message costs a fee. The way to
# try a policy against a real inbox.
AGENT_DRY_RUN=false

# Shared secret the confirmation codes are generated from, base32 — the form an authenticator app
# takes. Required only by a policy with requireConfirmation on a rule, and then the agent refuses to
# start without it. Generate it (README.md has one way): at least 16 bytes, per RFC 4226, and the
# agent refuses anything shorter.
AGENT_TOTP_SECRET=

# Where POST /approvals/{scheduleId} listens. Loopback by default, and it belongs behind whatever
# already fronts this service: a valid code there releases half a threshold signature.
AGENT_APPROVAL_HOST=127.0.0.1
AGENT_APPROVAL_PORT=8787

# Optional: a Mirror Node other than the public one.
# HEDERA_MIRROR_TESTNET_URL=
